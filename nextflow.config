manifest {
    name = 'Qmykzgo/functional-enrichment-workbench'
    mainScript = 'main.nf'
    description = 'Evidence-aware ORA and ranked gene-set enrichment workbench'
    version = '0.1.0'
}

params {
    input = 'assets/test-data/enrichment.csv'
    outdir = 'results/enrichment'
    mode = 'REAL'
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    cpus = 1
    memory = '1 GB'
    time = '10m'
    errorStrategy = 'terminate'
}

profiles {
    test {
        params.mode = 'STUB'
        params.input = 'assets/test-data/enrichment.csv'
        params.outdir = 'results/test'
    }
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
}

trace {
    enabled = true
    file = "${params.outdir}/provenance/trace.tsv"
}

report {
    enabled = true
    file = "${params.outdir}/provenance/execution-report.html"
}
